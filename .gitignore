# Dependencies
node_modules/

# Local secrets / env (never commit real credentials)
.env
.env.local
.env.*.local
!.env.example
.ops-control-token

# Local Firebase service account (contains private key)
firebase.json

# Local DB configs (may contain passwords)
config/config.json
config/config.prod.sync.json

# Runtime artifacts
backups/
logs/
uploads/
*.log
.DS_Store

# Runtime uploads (written by the API). Never commit what users upload: licence,
# profile, vehicle and proof photos are personal data. Each folder keeps a
# .gitkeep so it exists in a fresh clone; seed content already tracked stays
# tracked.
Public/BannerImages/*
Public/BarCodeImages/*
Public/BlogImages/*
Public/CategoryImages/*
Public/categoryImages/*
Public/DriverProfileImages/*
Public/Images/CountryFlags/*
Public/Images/VehicleTypes/*
Public/LicenseImages/*
Public/Profile/*
Public/VehicleImages/*
Public/collectionImages/*
Public/driverProofs/*
Public/onHoldImages/*
Public/repairImages/*
Public/serviceImages/*
!Public/**/.gitkeep
