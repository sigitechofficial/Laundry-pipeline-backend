# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Notes:
# - No spaces around "="
# - Do not wrap values in quotes unless the value itself needs them
# - Local DB still comes from config/config.json (MAMP: 127.0.0.1:8889 / laundry_pipeline)
# - Use TEST Stripe keys locally; never commit real .env secrets

# --- Core ---
NODE_ENV=development
PORT=3010
PUBLIC_BASE_URL=http://localhost:3010
# Max JSON / urlencoded body size. Multipart uploads use multer, not this.
# JSON_BODY_LIMIT=1mb

# --- Auth ---
JWT_ACCESS_SECRET=change_me_local_jwt_access_secret
JWT_GUEST_SECRET=change_me_local_jwt_guest_secret
GUEST_SESSION_DAYS=30
# Admin / zone-admin JWT lifetime (jsonwebtoken duration). Default 8h.
# ADMIN_JWT_EXPIRES_IN=8h

# --- Local / QA flags ---
# Fallback only. Live toggle is admin → Policies → Runtime checks
# (platformRuntimeSettings.geofenceBypassEnabled).
GEOFENCE_BYPASS_ENABLED=true
TWILIO_SKIP_SIGNATURE_VALIDATION=true
TWILIO_VOICE_ENABLED=false

# --- Email (ZeptoMail API — used by helper/zeptomailApi.js) ---
FROM_EMAIL=noreply@justdrycleans.com
FROM_NAME=Laundry Cleaner
ZEPTOMAIL_API_TOKEN=Zoho-enczapikey your_zeptomail_token_here

# SMTP transport (required when helper/transpoter.js is used)
EMAIL_FROM=noreply@justdrycleans.com
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
# SMTP_PORT=587
EMAIL_USER=emailapikey
EMAIL_PASSWORD=your_smtp_password_here
# SMTP_HOST=smtp.zeptomail.com
# SMTP_USER=emailapikey
# SMTP_PASS=your_smtp_password_here
# EMAIL_USERNAME_FOR_CUSTOMER=noreply@serviprapp.com

# --- Stripe (TEST keys for local) ---
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# --- Invoice auto-charge worker (env fallback; admin Runtime checks overrides) ---
# INVOICE_AUTO_CHARGE_ENABLED=true
INVOICE_AUTO_CHARGE_DELAY_MS=120000
INVOICE_AUTO_CHARGE_JOB_INTERVAL_MS=30000
# INVOICE_AUTO_CHARGE_MAX_ATTEMPTS=3
# INVOICE_AUTO_CHARGE_RETRY_GAP_MS=1800000

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# PHONE_CALL_SESSION_TTL_MINUTES=15

# --- Google Maps (server Geocoding — never ship this key to the admin SPA) ---
# Browser Maps JS key stays in admin-panel/.env as VITE_GOOGLE_MAPS_KEY.
GOOGLE_MAPS_KEY=
# GOOGLE_MAPS_SERVER_KEY=
# LAUNDRY_GOOGLE_MAPS_KEY=

# --- Gemini (admin blog assistant — server proxy only) ---
GEMINI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# LAUNDRY_GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# LAUNDRY_GEMINI_MODEL=gemini-2.0-flash

# --- Postcodes ---
# Used by code: IDEAL_POSTCODES_API_KEY
IDEAL_POSTCODES_API_KEY=
# Present on some cPanel envs but not referenced in current code:
# GETADDRESS_API_KEY=

# --- Firebase Realtime Database (live agent tracking) ---
# Enable RTDB in Firebase console, then set the exact URL (region may vary):
FIREBASE_DATABASE_URL=https://laundry-app-bf43c-default-rtdb.firebaseio.com
# LIVE_TRACKING_CLEANUP_INTERVAL_MS=3600000
# LIVE_TRACKING_CLEANUP_MAX_AGE_MS=21600000

# --- Debug / ops (optional — never commit real values) ---
# OPS_CONTROL_TOKEN=
# STAGE_TRIGGER_TOKEN=
# FCM_DEBUG_SECRET=
# DB_SYNC_TOKEN=

# --- Optional DB overrides used by some scripts ---
# DB_HOST=127.0.0.1
# DB_PORT=8889
# DB_USER=root
# DB_PASSWORD=root
# DB_NAME=laundry_pipeline

# --- Sequelize pool (per Node process). Defaults are local-MySQL safe. ---
# Raise DB_POOL_MAX only if MySQL max_connections can cover (instances × max).
# Hard ceiling in code is 50 per process.
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_ACQUIRE=30000
# DB_POOL_IDLE=10000
